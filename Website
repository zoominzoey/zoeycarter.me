    <script>
        // Substack URL & Contact Email Constants
        const SUBSTACK_URL = "https://tothatzoey.substack.com/?utm_campaign=profile_chips";
        const CONTACT_EMAIL = "contact@zoeycarter.me";

        // Featured Writing Data (Showcasing Thematic Pillars & Essays on "Down The Dirt Road")
        const writingEntries = [
            {
                category: "Rural Advocacy",
                readTime: "6 min dispatch",
                title: "Why Small-Town Pride Matters More Than Ever in the Heartland",
                excerpt: "Organizing Pride in Pekin, Illinois taught me that visibility in rural communities isn’t about importing big-city politics—it’s about showing our neighbors and queer youth that they already belong right where they are.",
                tag: "Rural Equality Project"
            },
            {
                category: "Working-Class Politics",
                readTime: "7 min essay",
                title: "From Machinists’ Tables to the Ballot Box: Speaking Plainly to Working Families",
                excerpt: "Growing up in a family of metal workers and spending 17 years in retail management showed me the gap between how political consultants talk and what working families actually worry about.",
                tag: "Economic Dignity"
            },
            {
                category: "Public Policy",
                readTime: "5 min analysis",
                title: "Municipal Transparency Starts in the Room Where Budgets Are Written",
                excerpt: "Local government decisions affect every pothole, property tax bill, and community program. Why civic watchdogs and accessible city council agendas are the backbone of small-town democracy.",
                tag: "Local Governance"
            },
            {
                category: "Personal Essays",
                readTime: "8 min reflection",
                title: "Back in the Classroom at ASU: Pursuing Public Policy 15 Years After High School",
                excerpt: "What returning to higher education as a first-generation high school graduate taught me about imposter syndrome, operational grit, and bringing real-world experience to policy school.",
                tag: "First-Gen Journey"
            },
            {
                category: "Rural Advocacy",
                readTime: "6 min essay",
                title: "Building Coalitions When You Don’t Agree on Everything",
                excerpt: "In a mid-sized Midwestern town, you can’t afford to write people off. How pragmatic community organizing builds durable bridges across neighborhoods and generations.",
                tag: "Grassroots Strategy"
            },
            {
                category: "Public Policy",
                readTime: "6 min commentary",
                title: "What Frontline Retail Operations Taught Me About Public Administration",
                excerpt: "Managing store operations for nearly two decades is a masterclass in resource allocation, crisis communication, and people-first leadership—lessons every policymaker needs.",
                tag: "Policy & Leadership"
            }
        ];

        // Render Writing Cards
        function renderWritingCards(selectedCategory = 'All') {
            const grid = document.getElementById('writing-grid');
            if (!grid) return;

            const filtered = selectedCategory === 'All'
                ? writingEntries
                : writingEntries.filter(item => item.category === selectedCategory);

            grid.innerHTML = filtered.map(item => `
                <article class="bg-white rounded-2xl p-7 border border-parchment-300 shadow-editorial hover:shadow-editorial-hover transition-all flex flex-col justify-between group">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-4">
                            <span class="px-2.5 py-1 rounded bg-parchment-200 text-ink-800 font-mono text-[11px] uppercase font-semibold">
                                ${item.category}
                            </span>
                            <span class="font-mono text-xs text-ink-500">${item.readTime}</span>
                        </div>
                        <h3 class="font-serif text-xl font-bold text-ink-900 group-hover:text-terracotta-600 transition-colors leading-snug">
                            <a href="${SUBSTACK_URL}" target="_blank" rel="noopener noreferrer">
                                ${item.title}
                            </a>
                        </h3>
                        <p class="text-sm text-ink-700 mt-3 leading-relaxed">
                            ${item.excerpt}
                        </p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-parchment-200 flex items-center justify-between">
                        <span class="font-mono text-[11px] text-ink-500">#${item.tag}</span>
                        <a href="${SUBSTACK_URL}" target="_blank" rel="noopener noreferrer" class="font-mono text-xs uppercase tracking-wider font-semibold text-terracotta-600 group-hover:text-terracotta-700 flex items-center gap-1">
                            <span>Read on Substack</span>
                            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </a>
                    </div>
                </article>
            `).join('');
        }

        // Filter Writing Pillar Categories
        function filterWriting(category) {
            const buttons = document.querySelectorAll('.writing-filter-btn');
            buttons.forEach(btn => {
                if (btn.getAttribute('data-filter') === category) {
                    btn.className = "writing-filter-btn px-3.5 py-2 rounded-lg text-xs font-mono uppercase tracking-wider font-semibold bg-ink-900 text-parchment-50 transition-all";
                } else {
                    btn.className = "writing-filter-btn px-3.5 py-2 rounded-lg text-xs font-mono uppercase tracking-wider font-semibold bg-parchment-200 text-ink-800 hover:bg-parchment-300 transition-all";
                }
            });
            renderWritingCards(category);
        }

        // Multi-Page SPA Navigation
        function navigateTo(pageId, skipScroll = false) {
            const validPages = ['about', 'writing', 'consulting', 'speaking'];
            const target = validPages.includes(pageId) ? pageId : 'about';

            // Toggle Sections
            document.querySelectorAll('.page-section').forEach(section => {
                section.classList.remove('active');
            });
            const activeSection = document.getElementById(`page-${target}`);
            if (activeSection) {
                activeSection.classList.add('active');
            }

            // Update Desktop Nav Active State
            document.querySelectorAll('.nav-btn').forEach(btn => {
                const navTarget = btn.getAttribute('data-nav');
                if (navTarget === target) {
                    btn.classList.add('bg-ink-900', 'text-parchment-50');
                    btn.classList.remove('text-ink-700', 'hover:bg-parchment-200');
                } else {
                    btn.classList.remove('bg-ink-900', 'text-parchment-50');
                    btn.classList.add('text-ink-700', 'hover:bg-parchment-200');
                }
            });

            // Update Mobile Nav Active State
            document.querySelectorAll('[data-nav-mobile]').forEach(btn => {
                const navTarget = btn.getAttribute('data-nav-mobile');
                if (navTarget === target) {
                    btn.classList.add('bg-parchment-200', 'text-terracotta-600');
                } else {
                    btn.classList.remove('bg-parchment-200', 'text-terracotta-600');
                }
            });

            // Close mobile menu if open
            const mobileMenu = document.getElementById('mobile-menu');
            if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
                toggleMobileMenu();
            }

            // Update URL hash cleanly
            if (history.pushState) {
                history.pushState(null, null, `#${target}`);
            } else {
                window.location.hash = target;
            }

            if (!skipScroll) {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        // Mobile Menu Toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            const openIcon = document.getElementById('menu-icon-open');
            const closeIcon = document.getElementById('menu-icon-close');
            if (!menu) return;

            menu.classList.toggle('hidden');
            openIcon.classList.toggle('hidden');
            closeIcon.classList.toggle('hidden');
        }

        // Pre-select Consulting Service & Scroll to Builder
        function selectConsultingService(serviceName) {
            const selectEl = document.getElementById('cons-service');
            if (selectEl) {
                selectEl.value = serviceName;
            }
            const builderEl = document.getElementById('consulting-builder');
            if (builderEl) {
                builderEl.scrollIntoView({ behavior: 'smooth' });
            }
            showToast(`Selected: ${serviceName}`);
        }

        // Pre-select Speaking Topic & Scroll to Booking Form
        function selectSpeakingTopic(topicName) {
            const selectEl = document.getElementById('spk-topic');
            if (selectEl) {
                selectEl.value = topicName;
            }
            const bookingEl = document.getElementById('speaking-booking');
            if (bookingEl) {
                bookingEl.scrollIntoView({ behavior: 'smooth' });
            }
            showToast("Topic selected in booking form below");
        }

        // Format Consulting Brief Helper
        function getConsultingBriefText() {
            const name = document.getElementById('cons-name').value.trim() || 'Prospective Client';
            const org = document.getElementById('cons-org').value.trim() || 'Not specified';
            const type = document.getElementById('cons-type').value;
            const service = document.getElementById('cons-service').value;
            const timeline = document.getElementById('cons-timeline').value;
            const notes = document.getElementById('cons-notes').value.trim() || 'Looking forward to discussing our project goals.';

            return {
                subject: `Consulting Inquiry: ${org} (${service})`,
                body: `Hello Zoey,\n\nI am reaching out regarding a consulting inquiry.\n\n• Contact Name: ${name}\n• Organization / Campaign: ${org}\n• Organization Type: ${type}\n• Primary Service Needed: ${service}\n• Target Timeline: ${timeline}\n\nProject Goals & Details:\n${notes}\n\nBest regards,\n${name}`
            };
        }

        // Handle Consulting Form Submit
        function handleConsultingSubmit(e) {
            e.preventDefault();
            const brief = getConsultingBriefText();
            const mailtoUrl = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(brief.subject)}&body=${encodeURIComponent(brief.body)}`;
            window.location.href = mailtoUrl;
            showToast("Opening email client addressed to contact@zoeycarter.me");
        }

        // Copy Consulting Brief to Clipboard
        function copyConsultingBrief() {
            const brief = getConsultingBriefText();
            copyTextToClipboard(`To: ${CONTACT_EMAIL}\nSubject: ${brief.subject}\n\n${brief.body}`, "Consulting brief copied to clipboard!");
        }

        // Format Speaking Booking Helper
        function getSpeakingBriefText() {
            const name = document.getElementById('spk-name').value.trim() || 'Event Organizer';
            const org = document.getElementById('spk-org').value.trim() || 'Host Organization';
            const date = document.getElementById('spk-date').value.trim() || 'TBD';
            const format = document.getElementById('spk-format').value;
            const topic = document.getElementById('spk-topic').value;
            const details = document.getElementById('spk-details').value.trim() || 'We would love to discuss hosting you for our upcoming event.';

            return {
                subject: `Speaking Inquiry: ${org} (${date})`,
                body: `Hello Zoey,\n\nWe would love to invite you to speak at our upcoming event.\n\n• Contact Name: ${name}\n• Host Organization / Event: ${org}\n• Proposed Date / Timeframe: ${date}\n• Event Format: ${format}\n• Preferred Topic: ${topic}\n\nEvent & Audience Details:\n${details}\n\nBest regards,\n${name}`
            };
        }

        // Handle Speaking Form Submit
        function handleSpeakingSubmit(e) {
            e.preventDefault();
            const brief = getSpeakingBriefText();
            const mailtoUrl = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(brief.subject)}&body=${encodeURIComponent(brief.body)}`;
            window.location.href = mailtoUrl;
            showToast("Opening booking email to contact@zoeycarter.me");
        }

        // Copy Speaking Brief to Clipboard
        function copySpeakingBrief() {
            const brief = getSpeakingBriefText();
            copyTextToClipboard(`To: ${CONTACT_EMAIL}\nSubject: ${brief.subject}\n\n${brief.body}`, "Speaking inquiry copied to clipboard!");
        }

        // Clipboard Copy Utility (using document.execCommand('copy') for reliable iFrame support)
        function copyTextToClipboard(text, successMsg) {
            const textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed";
            textArea.style.left = "-9999px";
            textArea.style.top = "0";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();

            try {
                document.execCommand('copy');
                showToast(successMsg);
            } catch (err) {
                showToast(`Email: ${CONTACT_EMAIL}`);
            }

            document.body.removeChild(textArea);
        }

        function copyEmailToClipboard() {
            copyTextToClipboard(CONTACT_EMAIL, "Copied contact@zoeycarter.me to clipboard!");
        }

        // Toast Feedback UI
        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('toast-notification');
            const msgEl = document.getElementById('toast-message');
            if (!toast || !msgEl) return;

            msgEl.textContent = message;
            toast.classList.remove('hidden');
            toast.classList.add('flex');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('hidden');
                toast.classList.remove('flex');
            }, 3400);
        }

        // Contact Modal Controls
        function openContactModal() {
            const modal = document.getElementById('contact-modal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        }

        function closeContactModal() {
            const modal = document.getElementById('contact-modal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        // Initialize on Window Load
        window.addEventListener('DOMContentLoaded', () => {
            // Render initial writing cards
            renderWritingCards('All');

            // Set initial page from URL hash if present
            const hash = window.location.hash.replace('#', '').toLowerCase();
            if (['about', 'writing', 'consulting', 'speaking'].includes(hash)) {
                navigateTo(hash, true);
            } else {
                navigateTo('about', true);
            }

            // Close modal on Escape key or backdrop click
            window.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeContactModal();
            });
            document.getElementById('contact-modal').addEventListener('click', (e) => {
                if (e.target.id === 'contact-modal') closeContactModal();
            });
        });
    </script>
</body>
</html>
